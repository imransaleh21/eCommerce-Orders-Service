{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "MongoDbConnection": "mongodb://$MONGO_HOST:$MONGO_PORT",
    "RedisConnection": "$REDIS_HOST:$REDIS_PORT"
  },
  "ApiGateway": {
    "BaseUrl": "http://api-gateway-container:8080" // For Docker container
  }
}